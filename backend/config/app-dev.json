{
  "_note": "Development and local demos (any NODE_ENV other than production): every module, the ops console at /, and demo secrets. Production uses config/app.json.",
  "baseUrl": "http://localhost:3000",
  "port": 3000,
  "modules": [
    "partners",
    "referrals",
    "webhooks",
    "payouts",
    "reports",
    "catalog",
    "integrations",
    "agent",
    "orgs",
    "users",
    "auth",
    "fhir",
    "affiliates",
    "ai",
    "oauth",
    "accounts",
    "pulse",
    "push",
    "backup",
    "shop",
    "portal",
    "subscriptions",
    "insights"
  ],
  "opsConsole": true,
  "storage": {
    "driver": "json",
    "dir": "./data"
  },
  "agent": {
    "provider": "rules"
  },
  "adminKey": "demo-admin-key-change-me",
  "authSecret": "demo-auth-secret-change-me",
  "ai": {
    "model": "claude-opus-5-5",
    "perMinute": 20,
    "prices": {
      "_note": "USD list prices for the model above, for the portal's AI costs ESTIMATE only (checked 2026-11-03; an owner can edit them in the portal). Per million tokens, and per 1000 web searches.",
      "model": "claude-opus-5-5",
      "inputPerMTok": 4,
      "outputPerMTok": 20,
      "cacheWritePerMTok": 5,
      "cacheReadPerMTok": 0.2,
      "webSearchPer1000": 10
    }
  },
  "pulse": {
    "k": 50
  },
  "backup": {
    "maxBytes": 4194304,
    "ttlDays": 90,
    "maxRows": 10000,
    "maxTotalBytes": 1073741824,
    "accountTtlDays": 365,
    "perAccount": 3,
    "failsPerAccount": 10
  }
}
