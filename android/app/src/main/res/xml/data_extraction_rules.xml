<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+): Cyra's whole health record lives in app-private storage on this
     phone and must not reach Google's backup servers or another device. android:allowBackup="false"
     alone does not stop device-to-device transfer on every manufacturer's devices, and a missing
     section leaves that transfer mode fully enabled, so both sections exclude every domain.
     Files in the cache, code-cache and no-backup directories are never transferred anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
