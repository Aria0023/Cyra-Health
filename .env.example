# Copy to .env (never commit .env). Set these in Render → Environment for production.
ANTHROPIC_API_KEY=            # server-side only; the proxy uses it, the browser never sees it
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
TERRA_API_KEY=
TERRA_DEV_ID=
ADMIN_KEY=                    # replaces demo-admin-key-change-me
AUTH_SECRET=                  # replaces demo-auth-secret-change-me
