# Copy to .env (never commit .env). Set these in Render → Environment for production.

# --- backend (Render web service "cyra-backend") ---
ANTHROPIC_API_KEY=            # server-side only; the AI proxy uses it, the browser never sees it. Unset = deterministic rules fallback.
AI_MODEL=claude-opus-5-5      # optional override of config/app.json ai.model
CORS_ORIGIN=                  # comma-separated allowlist of app origins, e.g. https://cyra-health.onrender.com. Unset = any origin.
ADMIN_KEY=                    # replaces demo-admin-key-change-me (x-admin-key on admin routes)
AUTH_SECRET=                  # replaces demo-auth-secret-change-me (org token signing)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=            # contents of the .p8 key (newlines as \n are fine)
PUBLIC_BASE_URL=              # backend public URL for OAuth callbacks; Render sets RENDER_EXTERNAL_URL automatically
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
TERRA_API_KEY=
TERRA_DEV_ID=

# --- static app (Render static site "cyra-health"; build-time, public, not a secret) ---
VITE_API_BASE=                # backend origin, e.g. https://cyra-backend.onrender.com. Unset = same origin.
