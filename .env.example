# Copy to .env (never commit .env). Set these in Render → Environment for production.

# --- backend (Render web service "cyra-backend") ---
ANTHROPIC_API_KEY=            # server-side only; the AI proxy uses it, the browser never sees it. Unset = Ask answers from the
                              #   rules fallback, and the Pro weekly write-up and chat (/api/ai/weekly, /api/ai/chat) answer 503:
                              #   the app then says "AI isn't set up on this server yet" and nothing is forwarded. The same
                              #   key powers Pro's "Ask with evidence" (/api/ai/evidence: Claude with the web search tool limited
                              #   to PubMed, MedlinePlus, CDC, NIH, ACOG, WHO, NICE…); web search must be enabled for the key's
                              #   organization in the Claude Console. Unset = it answers 503 and the app says so.
AI_MODEL=claude-opus-5-5      # optional override of config/app.json ai.model
ANTHROPIC_BASE_URL=           # optional: tests only (backend/scripts/ai-smoke.js points it at a mock). Leave unset in production.
CORS_ORIGIN=                  # comma-separated allowlist of app origins. Unset = any origin. Production:
                              #   https://cyra-health.onrender.com,capacitor://localhost,https://localhost
                              #   capacitor://localhost = the iOS app's web view, https://localhost = the Android app's.
RETURN_ORIGINS=               # optional: comma-separated http(s) origins a web sign-in/connect flow may return to.
                              #   Unset = the http(s) entries of CORS_ORIGIN. https://localhost and http://localhost
                              #   (the phone apps' web views) are never web returns. "*" or no list = any origin,
                              #   except with NODE_ENV=production, where it means none (fail closed).
NODE_ENV=                     # "production" on Render (set in render.yaml): mounts only what the shipped app calls
                              #   (config/app.json: push and ai, matching the app's default VITE_FEATURES), refuses to start unless
                              #   ADMIN_KEY and AUTH_SECRET are real values, and see RETURN_ORIGINS. Anything else
                              #   = development: config/app-dev.json, every module, demo secrets.
APP_RETURN_SCHEMES=cyrahealth # comma-separated URL schemes the phone app may be sent back to after sign-in or
                              #   connecting Oura/Terra: exactly <scheme>://auth/<oauth|oura|terra>, optionally
                              #   ?a=<attempt id>. Unset = cyrahealth.
                              #   javascript:, data:, file:, intent:, http(s): etc. can never be enabled here.
ADMIN_KEY=                    # required in production (16+ random chars, e.g. openssl rand -hex 32); replaces the demo value
AUTH_SECRET=                  # required in production, different from ADMIN_KEY; seals sign-in/connect redirect state and
                              #   signs account session tokens (changing it signs everyone out)
RESEND_API_KEY=               # email sign-in codes (accounts module), sent with Resend's HTTPS API. Unset in production =
                              #   "Continue with email" shows "isn't set up on this server yet"; unset in development = the code
                              #   is written to the server console instead. Secret: Render → cyra-backend → Environment only.
EMAIL_FROM=                   # the sender for sign-in codes, on a domain verified in Resend, e.g. "Solia Health <signin@yourdomain>"
# RESEND_API_BASE=            # tests only (scripts/accounts-smoke.js points it at a mock). Leave unset in production.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=            # contents of the .p8 key (newlines as \n are fine)
PUBLIC_BASE_URL=              # backend public URL for OAuth callbacks; Render sets RENDER_EXTERNAL_URL automatically
VAPID_PUBLIC_KEY=             # web push (browser reminders): run `npm run vapid` in backend/ once and paste both
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                # mailto:you@example.com — contact for push services
DATA_DIR=                     # optional: directory for the backend's JSON store (push.json; pulse.json and backup/ — the
                              #   account backups, which need a persistent disk before backup is listed — only
                              #   when those modules are listed in config/app.json); overrides
                              #   config storage.dir. Unset = ./data under backend/, which on Render without a
                              #   persistent disk is wiped on every deploy or restart. Point it at a persistent
                              #   disk's mount path (e.g. /var/data/cyra) once one is attached.
# Apple / Google / Facebook (above and below) are NEEDED IN PRODUCTION now: config/app.json mounts oauth and accounts (sign-in is
# required, owner request 2026-11-12). Each provider without its keys is reported as not configured and the app offers the
# others; with no provider and no RESEND_API_KEY at all, the app says sign-in isn't set up and lets her continue without one.
# Oura and Terra keys are NEEDED IN PRODUCTION too: config/app.json mounts integrations (wearables on by default, owner
# decision 2026-11-12). Without them the app shows Oura or Fitbit/Garmin/Whoop as "Not set up yet".
# Oura: OURA_CLIENT_ID + OURA_CLIENT_SECRET (Oura developer portal; redirect URI <backend>/api/integrations/oura/callback).
# Terra: TERRA_API_KEY + TERRA_DEV_ID + TERRA_SIGNING_SECRET (Terra dashboard; webhook URL <backend>/api/integrations/terra/webhook).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_SIGNING_SECRET=         # Terra dashboard → webhook signing secret (verifies terra-signature)
# TERRA_PROVIDERS=FITBIT,GARMIN,WHOOP   # optional: the Terra widget offers only these (the app's copy names these three)

# --- static app (Render static site "cyra-health"; build-time, public, not a secret) ---
VITE_REVENUECAT_IOS_KEY=      # Pro subscriptions + tips on iPhone (owner decision D4). RevenueCat → Project → API keys →
                              #   the Apple App Store PUBLIC SDK key (starts appl_). Public by design: it ships inside every
                              #   app and can only read offerings and make purchases. NOT the secret key (sk_), which must
                              #   never be in the app. Unset = the phone app says the store isn't connected; nothing sold.
VITE_REVENUECAT_ANDROID_KEY=  # the same for Google Play: the PUBLIC SDK key (starts goog_).
VITE_TIP_URL=                 # optional, web only: an https tip page (e.g. a Stripe Payment Link). Never shown in the phone
                              #   apps, which take tips through the app store. Unset = no tip link on the web.
VITE_API_BASE=                # backend origin, e.g. https://cyra-backend.onrender.com. Unset = no backend: the app makes
                              #   no server calls at all (no weekly counts, no Ask AI, no web reminders, no sign-in or
                              #   Oura/Terra) and says so where those features would be.
                              #   Required for the iOS/Android build (npm run cap:sync) to use any of them.
VITE_FEATURES=                # Optional features this build offers: a comma list of wearables, counts, ai, webReminders,
                              #   cloudBackup, signin and deviceSync; "all" = every one, "none" = none. Unset or empty = the
                              #   shipping defaults, ai,webReminders,signin,deviceSync,wearables: Ask Cyra's AI and browser reminders (each
                              #   still off for her until she turns it on) and, in the phone app, the on-phone sources.
                              #   deviceSync = Apple Health / Health Connect read by the app on the phone (never a server; the
                              #   "Today's auto-tracked" card, the cycle markers, the PDF table, You → Data sources); nothing
                              #   in a browser. wearables = Oura and Fitbit/Garmin/Whoop through the server (on by default
                              #   since 2026-11-12, owner decision; the earlier privacy-review recommendation for the
                              #   pass-through still stands, docs/PRIVACY-AUDIT.md); counts = anonymous weekly counts; signin = the Solia Health account (Apple, Google, Facebook
                              #   or an email code; needs oauth + accounts on the server); cloudBackup = the optional account (email + passphrase, both
                              #   turned into keys on the device) with an encrypted backup on Cyra's server; Pro only
                              #   (proDev unlocks it for QA). A feature that is off leaves no trace in the app and sends nothing.
                              #   A server feature also needs its module in backend/config/app.json ("modules":
                              #   wearables → integrations, counts → pulse, ai → ai, webReminders → push,
                              #   cloudBackup → backup, signin → accounts + oauth). Public build-time config, not a secret.
VITE_REQUIRE_SIGNIN=true      # "true" (default): when the server has at least one sign-in configured, registration has no skip and
                              #   existing users sign in once. "false": sign-in is offered with "Continue without an account" (the
                              #   one-line fallback if App Review objects to required sign-in, guideline 5.1.1). Public build config.
VITE_TERMS_URL=               # https:// address of the published, attorney-reviewed Terms of Use. Linked from the
VITE_PRIVACY_URL=             #   consent step (and the Privacy Policy). Unset = the build still passes but warns, and the
                              #   consent step says the documents aren't published yet instead of linking them.
                              #   Set both before any public release (web, iOS and Android builds). A production
                              #   build fetches each set URL and fails unless it serves a document (2xx HTML/PDF);
                              #   CYRA_SKIP_POLICY_FETCH=1 skips that check (offline CI only).
VITE_DEMO_WEARABLES=          # "true" only for demo builds: seeds illustrative wearable data and says so in the UI (needs wearables in VITE_FEATURES)
VITE_DEMO_SEED=               # "true" only for demo builds: starts every user with 75 days of illustrative symptom history
